impoet std.io;

struct Point {
    x: f64,
    y: f64,
}

enum Shape {
    Circle(f64),
    Rect(f64, f64),
}

fn area(s: Shape) -> f64 {
    switch (s) {
        case Circle(r):  return 3.14159 * r * r;
        case Rect(w, h): return w * h;
    }
}

fn read_config(path: string) -> string! {
    let file = try io.open(path);
    return try file.read_all();
}

fn main() -> int {
    let shapes = [Shape.Circle(2.0), Shape.Rect(3.0, 4.0)];
    var total = 0.0;

    for (s in shapes) {
        total += area(s);
    }

    print("Total area: ", total);
    return 0;
}
